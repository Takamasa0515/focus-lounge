<div>
  <h2>Dashboard</h2>
  <div>
    <%= link_to "ホーム" %>
    <%= link_to "設定" %>
  </div>
  <div>
    <span id="time">00:00:00</span>
  </div>
  <div class="timer-actions">
    <button id="start">開始</button>
    <button id="stop">停止</button>
    <button id="reset">リセット</button>
  </div>
  <div>
    <p>カテゴリー</p>
  </div>
  <div class="today-stats">
    <p class="label">今日の作業時間</p>
    <p class="value">02:15:00</p>
    <p>作業履歴</p>
  </div>
</div>